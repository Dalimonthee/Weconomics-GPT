      <data key="d0">Customer Driven Leads (CDL)</data>
      <data key="d1">Concept</data>
      <data key="d2">A type of lead that VRM is aimed at, giving a prospect the tools to commit to a seller and become a customer when there is a need.</data>
      <data key="d3">chunk-61f13cb789bea7683db5372a497cf9b9</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="VRM">
      <data key="d0">VRM</data>
      <data key="d1">Concept</data>
      <data key="d2">VRM (Vendor Relationship Management) is a concept that focuses on empowering customers and giving them more control in transactions, aiming for lower transaction costs and a partnership-like relationship between buyers and sellers.&lt;SEP&gt;Vendor Relationship Management, a concept and approach that empowers individuals to control their data in relation to organizations. It focuses on individual control and direction.</data>
      <data key="d3">chunk-a18dd982db79e8473ac2f97c0dc81f06&lt;SEP&gt;chunk-2c514e71a44aea9915f71ae5b109dc21</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="ProjectVRM">
      <data key="d0">ProjectVRM</data>
      <data key="d1">Organization</data>
      <data key="d2">ProjectVRM is an initiative focused on developing tools and services from a new perspective on CRM, emphasizing customer control and lower transaction costs.</data>
      <data key="d3">chunk-a18dd982db79e8473ac2f97c0dc81f06</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
