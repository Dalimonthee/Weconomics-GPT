    <edge source="Blockchain Organizing" target="Blockchain Lead">
      <data key="d5">2.0</data>
      <data key="d6">A Blockchain Lead is interested in how Blockchain Organizing can provide value.&lt;SEP&gt;The Blockchain Lead further develops Blockchain Organizing.</data>
      <data key="d7">Development&lt;SEP&gt;Value Proposition, Application</data>
