      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="Life Management Platform">
      <data key="d0">Life Management Platform</data>
      <data key="d1">Platform</data>
