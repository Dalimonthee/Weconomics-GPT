    </edge>
    <edge source="Blockchain Organizing" target="Organizations">
      <data key="d5">2.0</data>
      <data key="d6">Blockchain Organizing can change perspective on organizations.&lt;SEP&gt;Blockchain Organizing is implemented within the organization.</data>
