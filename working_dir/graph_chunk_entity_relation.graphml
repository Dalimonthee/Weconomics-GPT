      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="Bitcoin wallet">
      <data key="d0">Bitcoin wallet</data>
      <data key="d1">System</data>
      <data key="d2">A system used to store and manage Bitcoin. It can be offline (e.g., on a PC) or online (eWallet). Offline wallets allow users to download the complete database, while online wallets depend on a supplier.</data>
      <data key="d3">chunk-2d666492c06b72b3acdaaf417a46ebbc</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
