    <node id="Leadership">
      <data key="d0">Leadership</data>
      <data key="d1">Management</data>
      <data key="d2">The act of guiding or directing a group or organization.&lt;SEP&gt;The act of leading a group of people or an organization.&lt;SEP&gt;The action of leading a group of people or an organization.</data>
      <data key="d3">chunk-f8de7684eaa9214e3bd145ee0ad6dd5e&lt;SEP&gt;chunk-5bf9689960b5a615f73160647f45eb4b&lt;SEP&gt;chunk-5372fca27605b863c92a206f40e7d1ce&lt;SEP&gt;chunk-e7b4cfcb5217fb678295a92b2dce1add&lt;SEP&gt;chunk-5c4e508645dafe5462c20f99b327c186</data>
