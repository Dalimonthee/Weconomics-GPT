      <data key="d0">Mike Vizard</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">An individual who did a podcast with Doc Searls.&lt;SEP&gt;Mike Vizard is a person who had a conversation with Doc Searls about VRM.</data>
      <data key="d3">chunk-a18dd982db79e8473ac2f97c0dc81f06&lt;SEP&gt;chunk-2c514e71a44aea9915f71ae5b109dc21</data>
