      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="Consensus">
      <data key="d0">Consensus</data>
      <data key="d1">Process</data>
      <data key="d2">A decision-making process where all parties agree.&lt;SEP&gt;A mechanism used in blockchain to validate transactions. It involves agreeing on the state of the blockchain.&lt;SEP&gt;The process by which all participants in a blockchain network agree on the validity of transactions.</data>
      <data key="d3">chunk-4322631c6ab79cfbe8d80ecc2f1dee23&lt;SEP&gt;chunk-11304546e84047544f7ab77d780c1f76&lt;SEP&gt;chunk-439e69ca41d62eb2197ac8d9898d5561</data>
