    <node id="Vendor Relationship Management (VRM)">
      <data key="d0">Vendor Relationship Management (VRM)</data>
      <data key="d1">Concept</data>
      <data key="d2">A concept focused on managing relationships with vendors, presented as the counterpart to Customer Relationship Management (CRM). It aims to empower buyers in their interactions with suppliers.</data>
      <data key="d3">chunk-61f13cb789bea7683db5372a497cf9b9</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="CRM system">
      <data key="d0">CRM system</data>
      <data key="d1">System</data>
      <data key="d2">An IT system used to manage customer relationships, containing data on suspects, prospects, and customers. Its purpose is to convert suspects into customers efficiently.</data>
      <data key="d3">chunk-61f13cb789bea7683db5372a497cf9b9</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
