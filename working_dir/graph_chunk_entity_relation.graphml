    <node id="Employee">
      <data key="d0">Employee</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">An Employee is a person employed by an organization or company, working for wages or a salary, often at a non-executive level. Employees are individuals who contribute added value within the organization and are trusted by the manager to perform tasks correctly and adhere to agreements. The term generally refers to individuals working within an organization.
</data>
      <data key="d3">chunk-97e2bbf5a1b20b138a96e571edbe3b49&lt;SEP&gt;chunk-7790e270abe48659de241763cc295ace&lt;SEP&gt;chunk-97bf1ff7a9a0ca25ab9f8d5aef1c0355&lt;SEP&gt;chunk-8944df9960d4627149b020e777cd05a3&lt;SEP&gt;chunk-36e21d4687a349e85e73aa7f9938cd18&lt;SEP&gt;chunk-50f3afddce8bc964731907b7d70c528d&lt;SEP&gt;chunk-b2a72f0d6133d452b3d89271844e2f3b&lt;SEP&gt;chunk-ee92635ddcf90a64b087c72dedf9473d</data>
