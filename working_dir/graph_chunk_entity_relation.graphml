    <node id="Taylor">
      <data key="d0">Taylor</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">A designer who influenced the organization of work, particularly in factories.&lt;SEP&gt;A person who is associated with the concept of connecting people and resources to tasks.&lt;SEP&gt;A person whose management innovation is being discussed.</data>
      <data key="d3">chunk-4c4ce5447e396cdd3bf137858b73ad36&lt;SEP&gt;chunk-d5261cef893d2c990c7504f9ff838aee&lt;SEP&gt;chunk-fd840a5da22869f17616e95321a1be2e</data>
