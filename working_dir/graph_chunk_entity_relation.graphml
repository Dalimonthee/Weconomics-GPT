    <node id="Svenska Handelsbanken">
      <data key="d0">Svenska Handelsbanken</data>
      <data key="d1">Organization</data>
      <data key="d2">A 'lean' organization mentioned as an example.&lt;SEP&gt;A financial institution.</data>
      <data key="d3">chunk-e4198bb76b5c7a4e6c4e4bf6a530fdec&lt;SEP&gt;chunk-0e159991e1f1aeb8a0169a48ad5b8333</data>
