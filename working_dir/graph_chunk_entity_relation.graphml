      <data key="d0">Ford</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">A designer who influenced the organization of work, particularly in factories.&lt;SEP&gt;A person who is associated with the concept of connecting people and resources to tasks.</data>
      <data key="d3">chunk-4c4ce5447e396cdd3bf137858b73ad36&lt;SEP&gt;chunk-fd840a5da22869f17616e95321a1be2e</data>
