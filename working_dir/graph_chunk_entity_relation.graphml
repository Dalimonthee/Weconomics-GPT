      <data key="d0">Digital Accounting System</data>
      <data key="d1">System</data>
      <data key="d2">A system used for recording and checking transactions.</data>
      <data key="d3">chunk-439e69ca41d62eb2197ac8d9898d5561</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
    </node>
    <node id="Ecosystem">
      <data key="d0">Ecosystem</data>
      <data key="d1">Concept</data>
      <data key="d2">A complex network or interconnected system.&lt;SEP&gt;A network of interacting entities.</data>
      <data key="d3">chunk-439e69ca41d62eb2197ac8d9898d5561&lt;SEP&gt;chunk-cc15fe668555752ca731b2fc192c1d71&lt;SEP&gt;chunk-a4939f4e8ac2c42709b9b12969f13fb6&lt;SEP&gt;chunk-b5764b11860bd97da66e34d549f66280</data>
