      <data key="d0">Customer Common96</data>
      <data key="d1">Organization</data>
      <data key="d2">An organization created in 2012 from Project VRM, focused on education, research, support, and development of VRM tools for individuals. It facilitates relationships between individuals and organizations.</data>
      <data key="d3">chunk-2c514e71a44aea9915f71ae5b109dc21</data>
      <data key="d4">WB8_BlockchainOrganizing_Managers_book8p1v1_UK_KOPIE_INTERN_GERBRUIK (1).txt</data>
